<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Kovcheg" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/kovcheg_background</item>
        <item name="android:colorAccent">@color/kovcheg_button</item>
        <item name="android:navigationBarColor">@color/kovcheg_background</item>
        <item name="android:statusBarColor">@color/kovcheg_background</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/kovcheg_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/kovcheg_background</item>
    </style>
</resources>
